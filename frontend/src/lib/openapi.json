        "description": "Generic mutating-endpoint response. `name` / `sieve` are populated\nby individual routes; `response_model_exclude_none=True` keeps the\npayload minimal.",
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
