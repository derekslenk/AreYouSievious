              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/RuleDTO"
                },
                {
                  "$ref": "#/components/schemas/RawBlockDTO"
                }
              ]
            },
            "title": "Entries",
            "type": "array"
          },
          "requires": {
            "items": {
              "type": "string"
            },
            "title": "Requires",
            "type": "array"
          }
        },
        "title": "ScriptResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
