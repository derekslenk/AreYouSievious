        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "content"
        ],
        "title": "ScriptRawResponse",
        "type": "object"
      },
